<!--
  Quire QML resources.

  AppLoad requires resources.rcc: it calls QResource::registerResource() on it
  and there is no loose-file fallback. manifest.json's "entry" is a path
  *inside* this resource tree, so /ui/Main.qml below must match it.
-->
<RCC>
    <qresource>
        <file>ui/Main.qml</file>
        <file>ui/Messages.js</file>
        <file>ui/Style.js</file>
        <file>ui/Paging.js</file>
        <file>ui/Watch.js</file>
        <file>ui/Sorting.js</file>
        <file>ui/Reconcile.js</file>
        <file>ui/Deleting.js</file>
        <file>ui/Answers.js</file>
        <file>ui/Screens.js</file>
        <file>ui/SourceList.qml</file>
        <file>ui/AddSource.qml</file>
        <file>ui/SeriesGrid.qml</file>
        <file>ui/ChapterList.qml</file>
        <file>ui/WatchList.qml</file>
        <file>ui/DownloadedList.qml</file>
        <file>ui/ReaderHandoff.qml</file>
        <file>ui/Settings.qml</file>
        <file>ui/Keyboard.qml</file>
        <file>ui/PagerBar.qml</file>
    </qresource>
</RCC>
